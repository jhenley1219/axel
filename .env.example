# Axel environment variables
#
# Every variable here is OPTIONAL — Axel runs with sensible defaults for local
# use. Copy this file to `.env` only if you need to override something:
#
#   cp .env.example .env
#
# For local `npx axel` you usually need none of these. The variables below
# matter mainly for manual builds and self-hosted server/Docker deployments.

# ───────────────────────────── Auth & sessions ─────────────────────────────

# Signs session cookies (HMAC-SHA256). `npx axel` auto-generates and persists
# one in ~/.axel/config.json, so you only need to set this for server/Docker
# deployments where you want a stable secret across restarts.
# In production the server refuses to start if this is the dev default,
# shorter than 32 chars, or contains characters outside [A-Za-z0-9+/=_-].
# Generate one with: pnpm --filter server gen-secret   (or: openssl rand -hex 32)
# SESSION_SECRET=

# Set to "production" for server deployments. This forces login auth on,
# enforces SESSION_SECRET validation, disables the dev self-signed cert, and
# tightens CORS. Leave unset for local development.
# NODE_ENV=production

# Force login auth even outside production. The Docker compose files set this.
# REQUIRE_AUTH=true

# Extra comma-separated CORS origins. localhost / 127.0.0.1 are always allowed;
# private-network origins are allowed automatically outside production.
# ALLOWED_ORIGINS=https://axel.example.ts.net

# ───────────────────────────── Paths ─────────────────────────────

# Single workspace root. When set, the paths below derive from it
# (<root>/projects, <root>/data/..., <root>/.axel/mcp-registry).
# `npx axel` sets this to your current directory; `npx axel --root <dir>` overrides.
# WORKSPACE_ROOT=/path/to/your/workspace

# Individual overrides (used when WORKSPACE_ROOT is unset, or to override a
# single derived path). PROJECTS_DIR is the common parent of your project dirs
# and the working directory for agent invocations.
# PROJECTS_DIR=/path/to/your/projects
# ALLOWED_DIRS=/path/to/your/projects   # colon-separated dirs the agent may read/write
# CREDENTIALS_PATH=./data/credentials.json
# AUDIT_LOG_PATH=./data/audit/commands.jsonl
# SETTINGS_PATH=./data/settings.json
# MCP_REGISTRY_DIR=~/.axel/mcp-registry

# HTTP/HTTPS port (the `--port` CLI flag overrides this).
# PORT=8080

# ───────────────────────────── Agent runtime ─────────────────────────────

# Anthropic API key. Optional — if unset, Axel uses the claude CLI's own login
# (sign in from the in-app Settings, or have the CLI already authenticated).
# A key set here (or in Settings) is passed to the agent and takes precedence.
# ANTHROPIC_API_KEY=sk-ant-...

# Custom Anthropic-compatible base URL, passed through to the agent.
# ANTHROPIC_BASE_URL=

# Path to the `claude` binary if it is not auto-detected on PATH.
# CLAUDE_PATH=claude

# ───────────────────────────── Voice (server-side TTS) ─────────────────────────────

# Python 3 interpreter used for the local Piper/Kokoro TTS subprocess.
# PYTHON_PATH=python3

# Override the bundled python/ script dir (where TTS scripts and models live).
# PYTHON_SCRIPT_DIR=

# ───────────────────────────── Docker entrypoint (server only) ─────────────────────────────
# Used by docker-entrypoint.public.sh to configure git inside the container so
# the agent can commit and push. Never bake real tokens into an image.
# GIT_USER_NAME=axel
# GIT_USER_EMAIL=axel@localhost
# GITHUB_TOKEN=
